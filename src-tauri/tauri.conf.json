{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RandDeck",
  "version": "0.6.0",
  "identifier": "com.zhishutai.desktop",
  "mainBinaryName": "randdeck",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RandDeck",
        "width": 1180,
        "height": 820,
        "minWidth": 680,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "transparent": false,
        "theme": "Dark",
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; frame-ancestors 'none'",
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "RandDeck",
    "copyright": "Copyright (c) 2026 RandDeck contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
